{
  "name": "Structured Text",
  "scopeName": "source.st",
  "fileTypes": [
    "st"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#pragmas"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#typed-char-literals"
    },
    {
      "include": "#duration-literals"
    },
    {
      "include": "#date-and-time-literals"
    },
    {
      "include": "#typed-literals"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#direct-variables"
    },
    {
      "include": "#config-program"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#method-declaration"
    },
    {
      "include": "#function-block-declaration"
    },
    {
      "include": "#class-declaration"
    },
    {
      "include": "#interface-declaration"
    },
    {
      "include": "#program-declaration"
    },
    {
      "include": "#namespace-declaration"
    },
    {
      "include": "#configuration-declaration"
    },
    {
      "include": "#resource-declaration"
    },
    {
      "include": "#using-declaration"
    },
    {
      "include": "#action-declaration"
    },
    {
      "include": "#extends-clause"
    },
    {
      "include": "#implements-clause"
    },
    {
      "include": "#primitive-types"
    },
    {
      "include": "#var-parameter-section"
    },
    {
      "include": "#var-section"
    },
    {
      "include": "#type-section"
    },
    {
      "include": "#case-region"
    },
    {
      "include": "#array-of-type"
    },
    {
      "include": "#pointer-to-type"
    },
    {
      "include": "#ref-to-type"
    },
    {
      "include": "#keyword-declarations"
    },
    {
      "include": "#keyword-modifiers"
    },
    {
      "include": "#keyword-control-conditional"
    },
    {
      "include": "#keyword-control-loop"
    },
    {
      "include": "#keyword-control-flow"
    },
    {
      "include": "#keyword-operators"
    },
    {
      "include": "#keyword-type-operators"
    },
    {
      "include": "#keyword-constants"
    },
    {
      "include": "#language-variables"
    },
    {
      "include": "#standard-fbs"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#member-access"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifier-fallback"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "include": "#line-comment-documentation"
        },
        {
          "include": "#line-comment"
        },
        {
          "include": "#block-comment-paren"
        },
        {
          "include": "#block-comment-slash"
        }
      ]
    },
    "line-comment-documentation": {
      "name": "comment.line.documentation.st",
      "match": "///.*$"
    },
    "line-comment": {
      "name": "comment.line.double-slash.st",
      "match": "//.*$"
    },
    "block-comment-paren": {
      "name": "comment.block.st",
      "begin": "\\(\\*",
      "end": "\\*\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.st"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.st"
        }
      },
      "patterns": [
        {
          "include": "#block-comment-paren"
        }
      ]
    },
    "block-comment-slash": {
      "name": "comment.block.st",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.st"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.st"
        }
      },
      "patterns": [
        {
          "include": "#block-comment-slash"
        }
      ]
    },
    "pragmas": {
      "name": "meta.pragma.st",
      "begin": "(\\{stc:)([A-Za-z_][A-Za-z0-9_]*)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.pragma.begin.st"
        },
        "2": {
          "name": "keyword.other.pragma.st"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.pragma.end.st"
        }
      },
      "patterns": [
        {
          "include": "#pragma-strings"
        },
        {
          "include": "#pragma-braces"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.parameter.pragma.st"
        },
        {
          "match": "-?\\d+(?:\\.\\d+)?",
          "name": "constant.numeric.pragma.st"
        }
      ]
    },
    "pragma-strings": {
      "patterns": [
        {
          "name": "string.quoted.double.st",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.st",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.st",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.st",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "pragma-braces": {
      "name": "meta.pragma.payload.st",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#pragma-strings"
        },
        {
          "include": "#pragma-braces"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.parameter.pragma.st"
        },
        {
          "match": "-?\\d+(?:\\.\\d+)?",
          "name": "constant.numeric.pragma.st"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "include": "#string-typed-single"
        },
        {
          "include": "#string-typed-double"
        },
        {
          "include": "#string-single"
        },
        {
          "include": "#string-double"
        }
      ]
    },
    "string-typed-single": {
      "name": "string.quoted.single.st",
      "begin": "(?i:\\b(?:USTRING|STRING|WSTRING|CHAR|WCHAR|UCHAR|U)#)(')",
      "end": "'",
      "beginCaptures": {
        "0": {
          "name": "storage.type.string.st"
        },
        "1": {
          "name": "punctuation.definition.string.begin.st"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.st"
        }
      },
      "patterns": [
        {
          "include": "#string-escapes"
        }
      ]
    },
    "string-typed-double": {
      "name": "string.quoted.double.st",
      "begin": "(?i:\\b(?:USTRING|STRING|WSTRING|CHAR|WCHAR|UCHAR|U)#)(\")",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "storage.type.string.st"
        },
        "1": {
          "name": "punctuation.definition.string.begin.st"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.st"
        }
      },
      "patterns": [
        {
          "include": "#string-escapes"
        }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.st",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.st"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.st"
        }
      },
      "patterns": [
        {
          "include": "#string-escapes"
        }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.st",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.st"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.st"
        }
      },
      "patterns": [
        {
          "include": "#string-escapes"
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.st",
          "match": "\\$(?:\\$|'|\"|[LlNnPpRrTt]|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{2}|\\{[0-9A-Fa-f]{1,6}\\})"
        }
      ]
    },
    "typed-char-literals": {
      "name": "constant.character.st",
      "match": "(?i:\\b(?:CHAR|WCHAR|UCHAR)#[-+]?(?:(?:2|8|16)#[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|\\d(?:_?\\d)*))"
    },
    "duration-literals": {
      "name": "constant.numeric.duration.st",
      "match": "(?i:\\b(?:TIME|LTIME|T)#[-+]?\\d+(?:\\.\\d+)?(?:ms|us|ns|d|h|m|s)(?:_?\\d+(?:\\.\\d+)?(?:ms|us|ns|d|h|m|s))*)\\b"
    },
    "date-and-time-literals": {
      "patterns": [
        {
          "include": "#datetime-literal"
        },
        {
          "include": "#tod-literal"
        },
        {
          "include": "#date-literal"
        }
      ]
    },
    "datetime-literal": {
      "name": "constant.numeric.datetime.st",
      "match": "(?i:\\b(?:DATE_AND_TIME|LDATE_AND_TIME|DT|LDT)#\\d{4}-\\d{2}-\\d{2}-\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,9})?)\\b"
    },
    "tod-literal": {
      "name": "constant.numeric.time.st",
      "match": "(?i:\\b(?:TIME_OF_DAY|LTIME_OF_DAY|TOD|LTOD)#\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,9})?)\\b"
    },
    "date-literal": {
      "name": "constant.numeric.date.st",
      "match": "(?i:\\b(?:DATE|LDATE|D|LD)#\\d{4}-\\d{2}-\\d{2})\\b"
    },
    "typed-literals": {
      "name": "constant.numeric.typed.st",
      "match": "(?i:\\b(?:BOOL|SINT|INT|DINT|LINT|USINT|UINT|UDINT|ULINT|BYTE|WORD|DWORD|LWORD|REAL|LREAL)#[-+]?(?:(?:2|8|16)#[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|\\d(?:_?\\d)*(?:\\.\\d(?:_?\\d)*(?:[Ee][+-]?\\d(?:_?\\d)*)?)?|TRUE|FALSE))\\b"
    },
    "numbers": {
      "patterns": [
        {
          "include": "#based-literal"
        },
        {
          "include": "#real-literal"
        },
        {
          "include": "#integer-literal"
        }
      ]
    },
    "based-literal": {
      "name": "constant.numeric.based.st",
      "match": "\\b(?:2|8|16)#[0-9A-Fa-f](?:_?[0-9A-Fa-f])*\\b"
    },
    "real-literal": {
      "name": "constant.numeric.real.st",
      "match": "\\b\\d(?:_?\\d)*\\.\\d(?:_?\\d)*(?:[Ee][+-]?\\d(?:_?\\d)*)?\\b"
    },
    "integer-literal": {
      "name": "constant.numeric.integer.st",
      "match": "\\b\\d(?:_?\\d)*\\b"
    },
    "direct-variables": {
      "name": "variable.other.constant.st",
      "match": "%[IQM]?[XBWDL]?(?:\\d+(?:\\.\\d+)*|\\*)"
    },
    "config-program": {
      "match": "(?i:\\b(PROGRAM))\\s+(?:(RETAIN|NON_RETAIN)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(WITH)\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s*:\\s*(?:(BOOL|SINT|INT|DINT|LINT|USINT|UINT|UDINT|ULINT|BYTE|WORD|DWORD|LWORD|REAL|LREAL|LDATE_AND_TIME|LTIME_OF_DAY|DATE_AND_TIME|TIME_OF_DAY|ANY_ELEMENTARY|ANY_MAGNITUDE|ANY_DURATION|ANY_UNSIGNED|ANY_DERIVED|ANY_CHARS|ANY_STRING|ANY_SIGNED|ANY_NUM|ANY_REAL|ANY_INT|ANY_BIT|ANY_CHAR|ANY_DATE|ANY|TIME|LTIME|DATE|LDATE|TOD|LTOD|DT|LDT|STRING|WSTRING|CHAR|WCHAR|USTRING|UCHAR)\\b|([A-Za-z_][A-Za-z0-9_]*(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*){0,3}))",
      "captures": {
        "1": {
          "name": "keyword.declaration.st"
        },
        "2": {
          "name": "storage.modifier.st"
        },
        "3": {
          "name": "variable.name.st"
        },
        "4": {
          "name": "keyword.declaration.st"
        },
        "5": {
          "name": "variable.name.st"
        },
        "6": {
          "name": "support.type.primitives.st"
        },
        "7": {
          "name": "entity.name.type.st"
        }
      }
    },
    "program-declaration": {
      "match": "(?i:\\b(PROGRAM))\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.st"
        },
        "2": {
          "name": "entity.name.function.st"
        }
      }
    },
    "function-declaration": {
      "match": "(?i:\\b(FUNCTION))\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*:\\s*(?:(BOOL|SINT|INT|DINT|LINT|USINT|UINT|UDINT|ULINT|BYTE|WORD|DWORD|LWORD|REAL|LREAL|LDATE_AND_TIME|LTIME_OF_DAY|DATE_AND_TIME|TIME_OF_DAY|ANY_ELEMENTARY|ANY_MAGNITUDE|ANY_DURATION|ANY_UNSIGNED|ANY_DERIVED|ANY_CHARS|ANY_STRING|ANY_SIGNED|ANY_NUM|ANY_REAL|ANY_INT|ANY_BIT|ANY_CHAR|ANY_DATE|ANY|TIME|LTIME|DATE|LDATE|TOD|LTOD|DT|LDT|STRING|WSTRING|CHAR|WCHAR|USTRING|UCHAR)\\b|([A-Za-z_][A-Za-z0-9_]*(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*){0,3})))?",
      "captures": {
        "1": {
          "name": "keyword.declaration.st"
        },
        "2": {
          "name": "entity.name.function.st"
        },
        "3": {
          "name": "support.type.primitives.st"
        },
        "4": {
          "name": "entity.name.type.st"
        }
      }
    },
    "method-declaration": {
      "match": "(?i:\\b(METHOD))\\s+(?:(PUBLIC|PRIVATE|PROTECTED|INTERNAL)\\s+)?(?:(FINAL|ABSTRACT)\\s+)?(?:(OVERRIDE)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(?:\\s*:\\s*(?:(BOOL|SINT|INT|DINT|LINT|USINT|UINT|UDINT|ULINT|BYTE|WORD|DWORD|LWORD|REAL|LREAL|LDATE_AND_TIME|LTIME_OF_DAY|DATE_AND_TIME|TIME_OF_DAY|ANY_ELEMENTARY|ANY_MAGNITUDE|ANY_DURATION|ANY_UNSIGNED|ANY_DERIVED|ANY_CHARS|ANY_STRING|ANY_SIGNED|ANY_NUM|ANY_REAL|ANY_INT|ANY_BIT|ANY_CHAR|ANY_DATE|ANY|TIME|LTIME|DATE|LDATE|TOD|LTOD|DT|LDT|STRING|WSTRING|CHAR|WCHAR|USTRING|UCHAR)\\b|([A-Za-z_][A-Za-z0-9_]*(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*){0,3})))?",
      "captures": {
        "1": {
          "name": "keyword.declaration.st"
        },
        "2": {
          "name": "storage.modifier.st"
        },
        "3": {
          "name": "storage.modifier.st"
        },
        "4": {
          "name": "storage.modifier.st"
        },
        "5": {
          "name": "entity.name.function.st"
        },
        "6": {
          "name": "support.type.primitives.st"
        },
        "7": {
          "name": "entity.name.type.st"
        }
      }
    },
    "function-block-declaration": {
      "match": "(?i:\\b(FUNCTION_BLOCK))\\s+(?:(FINAL|ABSTRACT)\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.st"
        },
        "2": {
          "name": "storage.modifier.st"
        },
        "3": {
          "name": "entity.name.type.st"
        }
      }
    },
    "class-declaration": {
      "match": "(?i:\\b(CLASS))\\s+(?:(FINAL|ABSTRACT)\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.st"
        },
        "2": {
          "name": "storage.modifier.st"
        },
        "3": {
          "name": "entity.name.type.st"
        }
      }
    },
    "interface-declaration": {
      "match": "(?i:\\b(INTERFACE))\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.st"
        },
        "2": {
          "name": "entity.name.type.st"
        }
      }
    },
    "namespace-declaration": {
      "match": "(?i:\\b(NAMESPACE))\\s+(?:(INTERNAL)\\s+)?([A-Za-z_][A-Za-z0-9_]*(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.st"
        },
        "2": {
          "name": "storage.modifier.st"
        },
        "3": {
          "name": "entity.name.namespace.st"
        }
      }
    },
    "configuration-declaration": {
      "match": "(?i:\\b(CONFIGURATION))\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.st"
        },
        "2": {
          "name": "entity.name.namespace.st"
        }
      }
    },
    "resource-declaration": {
      "match": "(?i:\\b(RESOURCE))\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(ON)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": {
          "name": "keyword.declaration.st"
        },
        "2": {
          "name": "entity.name.namespace.st"
        },
        "3": {
          "name": "keyword.declaration.st"
        },
        "4": {
          "name": "entity.name.namespace.st"
        }
      }
    },
    "using-declaration": {
      "match": "(?i:\\b(USING))\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*)?(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*)?)*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.st"
        },
        "2": {
          "name": "entity.name.namespace.st"
        }
      }
    },
    "action-declaration": {
      "match": "(?i:\\b(ACTION))\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.st"
        },
        "2": {
          "name": "entity.name.function.st"
        }
      }
    },
    "extends-clause": {
      "match": "(?i:\\b(EXTENDS))\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*)*)*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.st"
        },
        "2": {
          "name": "entity.other.inherited-class.st"
        }
      }
    },
    "implements-clause": {
      "match": "(?i:\\b(IMPLEMENTS))\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*)*)*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.st"
        },
        "2": {
          "name": "entity.other.inherited-class.st"
        }
      }
    },
    "primitive-types": {
      "name": "support.type.primitives.st",
      "match": "(?i:\\b(?:BOOL|SINT|INT|DINT|LINT|USINT|UINT|UDINT|ULINT|BYTE|WORD|DWORD|LWORD|REAL|LREAL|LDATE_AND_TIME|LTIME_OF_DAY|DATE_AND_TIME|TIME_OF_DAY|ANY_ELEMENTARY|ANY_MAGNITUDE|ANY_DURATION|ANY_UNSIGNED|ANY_DERIVED|ANY_CHARS|ANY_STRING|ANY_SIGNED|ANY_NUM|ANY_REAL|ANY_INT|ANY_BIT|ANY_CHAR|ANY_DATE|ANY|TIME|LTIME|DATE|LDATE|TOD|LTOD|DT|LDT|STRING|WSTRING|CHAR|WCHAR|USTRING|UCHAR)\\b)"
    },
    "var-parameter-section": {
      "begin": "(?i:\\b(?:VAR_INPUT|VAR_OUTPUT|VAR_IN_OUT)\\b)",
      "beginCaptures": {
        "0": {
          "name": "keyword.declaration.st"
        }
      },
      "end": "(?i:\\bEND_VAR\\b)",
      "endCaptures": {
        "0": {
          "name": "keyword.declaration.st"
        }
      },
      "patterns": [
        {
          "include": "#array-of-type"
        },
        {
          "include": "#pointer-to-type"
        },
        {
          "include": "#ref-to-type"
        },
        {
          "include": "#type-after-colon"
        },
        {
          "include": "#declared-parameter"
        },
        {
          "include": "#expression-leaves"
        }
      ]
    },
    "var-section": {
      "begin": "(?i:\\b(?:VAR_GLOBAL|VAR_EXTERNAL|VAR_ACCESS|VAR_CONFIG|VAR_TEMP|VAR)\\b)",
      "beginCaptures": {
        "0": {
          "name": "keyword.declaration.st"
        }
      },
      "end": "(?i:\\bEND_VAR\\b)",
      "endCaptures": {
        "0": {
          "name": "keyword.declaration.st"
        }
      },
      "patterns": [
        {
          "include": "#array-of-type"
        },
        {
          "include": "#pointer-to-type"
        },
        {
          "include": "#ref-to-type"
        },
        {
          "include": "#type-after-colon"
