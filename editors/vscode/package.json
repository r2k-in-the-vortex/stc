                "constant.numeric.date.st",
                "constant.numeric.time.st",
                "constant.numeric.datetime.st",
                "constant.numeric.pragma.st"
              ],
              "settings": {
                "foreground": "#098658"
              }
            },
            {
              "name": "ST language constant",
              "scope": [
                "constant.language.st"
              ],
              "settings": {
                "foreground": "#0000FF"
              }
            },
            {
              "name": "ST operator and punctuation",
              "scope": [
                "keyword.operator.st",
                "keyword.operator.type.st",
                "punctuation.st",
                "punctuation.definition.comment.begin.st",
                "punctuation.definition.comment.end.st",
                "punctuation.definition.string.begin.st",
                "punctuation.definition.string.end.st"
              ],
              "settings": {
                "foreground": "#1F1F1F"
              }
            },
            {
              "name": "ST pragma",
              "scope": [
                "keyword.other.pragma.st",
                "punctuation.definition.pragma.begin.st",
                "punctuation.definition.pragma.end.st"
              ],
              "settings": {
                "foreground": "#B45309"
              }
            }
          ]
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs && vscode-tmgrammar-test -g syntaxes/st.tmLanguage.json \"test/grammar/*.st\"",
    "test:electron": "node test/electron/runTest.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.82.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vscode-tmgrammar-test": "0.1.3"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
