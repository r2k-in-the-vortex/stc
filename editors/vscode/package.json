{
  "name": "stc-vscode",
  "displayName": "stc Structured Text",
  "description": "Local Structured Text support for stc: syntax highlighting, language features, tasks, compiler diagnostics, and debugging.",
  "version": "0.1.0",
  "publisher": "stc-local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r2k-in-the-vortex/stc.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [
    "structured text",
    "iec 61131-3",
    "stc",
    "plc"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:st",
    "onDebugResolve:stc",
    "workspaceContains:**/stc.toml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "stc.startOnlineChange",
        "title": "Start Online Change",
        "category": "stc"
      },
      {
        "command": "stc.stopOnlineChange",
        "title": "Stop Online Change",
        "category": "stc",
        "enablement": "stc.onlineChangeActive"
      },
      {
        "command": "stc.showOnlineChangeStatus",
        "title": "Show Online Change Status",
        "category": "stc"
      },
      {
        "command": "stc.attachOnlineDebugger",
        "title": "Attach Debugger to Online Change",
        "category": "stc",
        "enablement": "stc.onlineChangeAttachable"
      }
    ],
    "languages": [
      {
        "id": "st",
        "aliases": [
          "Structured Text",
          "ST",
          "st"
        ],
        "extensions": [
          ".st"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "st",
        "scopeName": "source.st",
        "path": "./syntaxes/st.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "stc Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/stc-dark-color-theme.json"
      },
      {
        "label": "stc Light",
        "uiTheme": "vs",
        "path": "./themes/stc-light-color-theme.json"
      }
    ],
    "breakpoints": [
      {
        "language": "st"
      }
    ],
    "debuggers": [
      {
        "type": "stc",
        "label": "stc Structured Text",
        "languages": [
          "st"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "project": {
                "type": "string",
                "default": "${workspaceFolder}/stc.toml",
                "description": "Path to stc.toml, its directory, or a project directory."
              },
              "outDir": {
                "type": "string",
                "description": "Output directory override; used by noBuild."
              },
              "noBuild": {
                "type": "boolean",
                "default": false,
                "description": "Launch existing artifacts without building."
              },
              "release": {
                "type": "boolean",
                "default": false,
                "description": "Build in release mode (monitoring only: no breakpoints, stepping, or locals)."
              },
              "allowWrite": {
                "type": "boolean",
                "default": false,
                "description": "Enable setVariable writes; the host must also allow [debug].allow-write."
              },
              "allowForce": {
                "type": "boolean",
                "default": false,
                "description": "Request the force scope; the host must also allow [debug].allow-force."
              },
              "sourceRoot": {
                "type": "string",
                "description": "Override the source-path root instead of resolving package roots."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Extra arguments appended to the launched host."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the launched host."
              }
            }
          },
          "attach": {
            "properties": {
              "project": {
                "type": "string",
                "default": "${workspaceFolder}/stc.toml",
                "description": "Path to stc.toml, its directory, or a project directory."
              },
              "endpoint": {
                "type": "string",
                "default": "${workspaceFolder}/target/stc/debug/debug.endpoint.json",
                "description": "Endpoint file printed by `stc run --debug-server`."
              },
              "outDir": {
                "type": "string",
                "description": "Output directory override; used by noBuild."
              },
              "noBuild": {
                "type": "boolean",
                "default": false,
                "description": "Launch existing artifacts without building."
              },
              "release": {
                "type": "boolean",
                "default": false,
                "description": "Build in release mode (monitoring only)."
              },
              "allowWrite": {
                "type": "boolean",
                "default": false,
                "description": "Enable setVariable writes; the host must also allow [debug].allow-write."
              },
              "allowForce": {
                "type": "boolean",
                "default": false,
                "description": "Request the force scope; the host must also allow [debug].allow-force."
              },
              "sourceRoot": {
                "type": "string",
                "description": "Override the source-path root instead of resolving package roots."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Extra arguments appended to the launched host."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the launched host."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "stc",
            "request": "launch",
            "name": "stc: Launch",
            "project": "${workspaceFolder}/stc.toml",
            "noBuild": false
          },
          {
            "type": "stc",
            "request": "attach",
            "name": "stc: Attach",
            "project": "${workspaceFolder}/stc.toml",
            "endpoint": "${workspaceFolder}/target/stc/debug/debug.endpoint.json"
          }
        ],
        "configurationSnippets": [
          {
            "label": "stc: Launch",
            "description": "Build and debug the local stc project.",
            "body": {
              "type": "stc",
              "request": "launch",
              "name": "stc: Launch",
              "project": "^\"\\${workspaceFolder}/stc.toml\"",
              "noBuild": false
            }
          },
          {
            "label": "stc: Attach",
            "description": "Attach to a running `stc run --debug-server` endpoint.",
            "body": {
              "type": "stc",
              "request": "attach",
              "name": "stc: Attach",
              "project": "^\"\\${workspaceFolder}/stc.toml\"",
              "endpoint": "^\"\\${workspaceFolder}/target/stc/debug/debug.endpoint.json\""
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "stc",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "check",
              "build",
              "run",
              "test",
              "fmt"
            ],
            "description": "The stc command to run."
          },
          "project": {
            "type": "string",
            "description": "Path to stc.toml, its directory, or a project directory. Defaults to the first stc.toml in the workspace."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional arguments appended to the command."
          },
          "release": {
            "type": "boolean",
            "description": "Pass --release for build and run tasks."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "stc",
        "owner": "stc",
        "source": "stc",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning)\\[(STC-[EW]-[A-Z0-9-]+)\\]: (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "configuration": {
      "title": "stc",
      "properties": {
        "stc.path": {
          "type": "string",
          "default": "stc",
          "description": "Path to the stc compiler executable, or its name on PATH."
        },
        "stc.onlineChange.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Extra arguments appended to `stc run --watch`, such as --release, --store, or --watch-timeout. The extension owns --manifest-path, --debug-server, --debug-endpoint, --color, the control flags, and --quiet."
        }
      }
    },
