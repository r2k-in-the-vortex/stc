INTERFACE Drivable
  METHOD Drive : BOOL
    VAR_INPUT
      speed : DINT;
    END_VAR
  END_METHOD
END_INTERFACE

FUNCTION_BLOCK Motor IMPLEMENTS Drivable
VAR
  speed : DINT;
END_VAR
METHOD PUBLIC Drive : BOOL
VAR_INPUT
  speed : DINT;
END_VAR
  THIS.speed := speed;
  Drive := TRUE;
END_METHOD
END_FUNCTION_BLOCK

CLASS ABSTRACT Vehicle IMPLEMENTS Drivable
VAR
  id : DINT;
END_VAR
METHOD ABSTRACT Drive : BOOL
END_METHOD
END_CLASS

CLASS Car EXTENDS Vehicle
METHOD OVERRIDE Drive : BOOL
  Drive := TRUE;
END_METHOD
END_CLASS
