    then core.str.Str.len text
    else
      let a ←
        core.fmt.rt.Argument.new_display (Shared0T.Insts.CoreFmtDisplay
          Str.Insts.CoreFmtDisplay) text
      let _ ←
        core.fmt.Arguments.new
          (Array.make 31#usize [
            13#u8, 83#u8, 66#u8, 67#u8, 83#u8, 32#u8, 118#u8, 101#u8, 99#u8,
            116#u8, 111#u8, 114#u8, 32#u8, 96#u8, 192#u8, 14#u8, 96#u8, 32#u8,
