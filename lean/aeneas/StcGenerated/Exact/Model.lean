            67#u8, 73#u8, 73#u8, 0#u8
            ]) (Array.make 1#usize [ a ])
      fail panic
  | StringKind.Dbcs =>
    let eu ← core.str.Str.encode_utf16 text
    core.str.iter.EncodeUtf16.Insts.CoreIterTraitsIteratorIteratorU16.count eu
  | StringKind.Unicode =>
